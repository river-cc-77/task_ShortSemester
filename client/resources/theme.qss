/* ============================================================
   充电桩用户端 · Client Theme（与 Admin 端同源设计语言）
   设计语言：浅色专业内容区 + 白色圆角卡片（云控制台风格）
   主色  #2B6BFF   辅助青 #00C6F5   成功 #18B46B
   警告  #FF9F43   危险   #FF5B5B
   通过 resources.qrc 打包，在 main.cpp 中全局加载。
   ============================================================ */

/* ------------------------- 基础排版 ------------------------- */
QWidget {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "PingFang SC",
                 "Noto Sans CJK SC", "WenQuanYi Micro Hei", sans-serif;
    font-size: 10.5pt;
    color: #25324F;
}

QMainWindow, QDialog {
    background-color: #EDF2F9;
}

QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #25324F;
}

QToolTip {
    background-color: #14263F;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 6px 10px;
}

/* ------------------------- 标签 ------------------------- */
QLabel {
    background: transparent;
    color: #25324F;
}

/* ------------------------- 输入控件 ------------------------- */
QLineEdit, QTextEdit, QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #D8E0EC;
    border-radius: 8px;
    padding: 6px 10px;
    min-height: 24px;
    selection-background-color: #D6E4FF;
    selection-color: #1F2D4D;
}

QLineEdit:focus, QComboBox:focus {
    border-color: #2B6BFF;
    background-color: #FFFFFF;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #F2F4F8;
    color: #9AA4B5;
}

QLineEdit:read-only {
    background-color: #F6F8FC;
    color: #66758F;
}

/* 下拉框 */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #EEF1F6;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #7C8AA6;
    margin-right: 6px;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #C9D4E6;
    border-radius: 8px;
    padding: 4px;
    outline: none;
    selection-background-color: #DCE8FF;
    selection-color: #2B6BFF;
}

QComboBox QAbstractItemView::item {
    min-height: 28px;
    padding: 0 10px;
    border-radius: 6px;
}

/* ------------------------- 通用按钮 ------------------------- */
QPushButton {
    background-color: #FFFFFF;
    color: #3A4A66;
    border: 1px solid #D8E0EC;
    border-radius: 8px;
    padding: 8px 18px;
    min-height: 20px;
}

QPushButton:pressed {
    background-color: #E2ECFF;
}

QPushButton:focus {
    outline: none;
}

QPushButton:disabled {
    background-color: #F2F4F8;
    color: #A8B0C0;
    border-color: #E3E8F0;
}

/* 主操作按钮（品牌蓝渐变） */
QPushButton[class="primary"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3D7EFF, stop:1 #2B6BFF);
    color: #FFFFFF;
    border: 1px solid #1F5AE6;
    font-weight: 600;
}

QPushButton[class="primary"]:pressed {
    background: #1F5AE6;
    border-color: #1A50D0;
    color: #FFFFFF;
}

QPushButton[class="primary"]:disabled {
    background: #A9C4F0;
    border-color: #A9C4F0;
    color: #FFFFFF;
}

/* 危险操作按钮 */
QPushButton[class="danger"] {
    background-color: #FDEEEE;
    color: #E5484D;
    border-color: #F3C9C9;
    font-weight: 600;
}

/* 成功/正向操作按钮 */
QPushButton[class="success"] {
    background-color: #E8F7EE;
    color: #17A05A;
    border-color: #BFE6CD;
    font-weight: 600;
}

/* 次要信息按钮（青色） */
QPushButton[class="info"] {
    background-color: #E8F6FD;
    color: #0E8FC0;
    border-color: #BFE3F4;
    font-weight: 600;
}

/* ------------------------- 列表 ------------------------- */
QListWidget {
    background-color: #FFFFFF;
    border: 1px solid #E3EAF4;
    border-radius: 12px;
    padding: 6px;
}

QListWidget:focus {
    border: 1px solid #A9C4F0;
}

QListWidget::item {
    padding: 9px 12px;
    border-bottom: 1px solid #F0F3F9;
    border-radius: 6px;
}

QListWidget::item:selected {
    background-color: #DCE8FF;
    color: #1F2D4D;
}

/* ------------------------- 滚动条 ------------------------- */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #C4CFDE;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar:horizontal {
    background: transparent;
    height: 8px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #C4CFDE;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    width: 0;
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

/* ============================================================
   登录页（深色科技渐变 + 居中白色卡片，与 Admin 一致）
   ============================================================ */
QWidget#loginRoot {
    background: qradialgradient(cx:0.16, cy:0.10, radius:1.4, fx:0.16, fy:0.10,
                                stop:0 #2C5AA0, stop:0.35 #16365F, stop:1 #0A1628);
}

QWidget#loginCard {
    background-color: #FFFFFF;
    border: 1px solid rgba(255,255,255,0.35);
    border-radius: 18px;
}

QLabel#loginTitle {
    font-size: 19pt;
    font-weight: 700;
    color: #0F1F38;
}

QLabel#loginSubtitle {
    font-size: 10.5pt;
    color: #8FA0BA;
}

QLabel#loginPhoneHint {
    font-size: 9.5pt;
    color: #A6B2C7;
}

QLabel#errorLabel {
    color: #E5484D;
    font-size: 10pt;
}

#loginCard QPushButton#loginButton {
    font-size: 11pt;
    min-height: 42px;
}

/* ============================================================
   主窗口：蓝系渐变铺底 + 白色圆角卡片（原来是纯色 #EDF2F9）
   ============================================================ */
QMainWindow#MainWindow {
    background: qlineargradient(x1:0, y1:0, x2:0.35, y2:1,
                                stop:0 #E8F0FC, stop:0.55 #DCE8FA, stop:1 #C9DBF5);
}

/* 页面容器必须透明，否则渐变背景被盖住 */
QWidget#centralWidget,
QStackedWidget#pageStack,
QWidget#pageStations,
QWidget#pageMap,
QWidget#pageProfile,
QWidget#topBar {
    background: transparent;
}

/* 顶部欢迎栏：三页共用一份，透明叠在渐变上 */
QLabel#userGreet {
    font-size: 12pt;
    font-weight: 700;
    color: #1F2D4D;
}

/* 定位输入卡片 / 个人中心卡片 */
QWidget#searchCard, QWidget#profileCard {
    background-color: #FFFFFF;
    border: 1px solid #E3EAF4;
    border-radius: 12px;
}

/* 卡片内小标题 */
QLabel#sectionTitle {
    font-size: 10pt;
    font-weight: 600;
    color: #7C8AA6;
}

/* 经纬度输入框（手机竖屏下两列均分） */
QLineEdit#latEdit, QLineEdit#lngEdit {
    min-width: 88px;
}

/* 页0 的位置摘要：扁平按钮，既是回显也是进地图页的入口 */
QPushButton#locationChip {
    background-color: #FFFFFF;
    border: 1px solid #E3EAF4;
    border-radius: 10px;
    color: #2B6BFF;
    font-size: 9.5pt;
    text-align: left;
    padding: 9px 12px;
}
/* 个人中心头像：正圆（border-radius 必须是直径 64 的一半）。
   无头像时以昵称首字占位，所以这里也定义了配色与字号。 */
QLabel#profileAvatar {
    background-color: #E8F0FC;
    border-radius: 32px;
    color: #2B6BFF;
    font-size: 20pt;
    font-weight: 700;
}

/* 个人中心账户概览 */
QLabel#profileSummary {
    color: #25324F;
    font-size: 10.5pt;
    line-height: 150%;
}

/* 个人中心的四个入口按钮（手机紧凑样式，原在顶部卡片里） */
QWidget#pageProfile QPushButton {
    padding: 12px 8px;
    border-radius: 10px;
    font-size: 10.5pt;
}

/* 底部状态行 */
QLabel#statusLabel {
    color: #8FA0BA;
    font-size: 9.5pt;
    padding: 2px 4px;
}

/* ============================================================
   底部导航（手机三 Tab）：深蓝渐变 + 选中项青色顶条
   ============================================================ */
QWidget#bottomNav {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #0B1B33, stop:0.5 #0F2440, stop:1 #0D2446);
    border-top: 1px solid #16304F;
}

QPushButton#navTabStations, QPushButton#navTabMap, QPushButton#navTabProfile {
    background: transparent;
    border: none;
    border-top: 3px solid transparent;   /* 占位，避免选中时文字跳动 */
    color: #8FA0BA;
    font-size: 10pt;
    padding: 10px 4px;
}

/* 选中态：三个 Tab 都设了 checkable，否则 :checked 永不匹配 */
QPushButton#navTabStations:checked, QPushButton#navTabMap:checked,
QPushButton#navTabProfile:checked {
    color: #FFFFFF;
    font-weight: 700;
    border-top: 3px solid #00C6F5;
}

/* ============================================================
   地图定位页（原导航弹窗，现为常驻页面）
   注意：类名不再是 QDialog，类型选择器必须同步改为 QWidget，
   否则这条规则静默失效、导航页掉样式。
   ============================================================ */
QWidget#navDialog {
    background: transparent;
}

QWidget#navDialog QPushButton[class="primary"] {
    font-size: 11pt;
    min-height: 42px;
}

/* 线路设置面板的滚动区：只滚内容，不要边框和底色 */
QScrollArea#navSetupScroll {
    background: transparent;
    border: none;
}
QScrollArea#navSetupScroll > QWidget > QWidget {
    background: transparent;
}

QLabel#navMapPreview {
    background-color: #FFFFFF;
    border: 1px solid #E3EAF4;
    border-radius: 10px;
}

QStackedWidget#navMapStack {
    background-color: #FFFFFF;
    border: 1px solid #E3EAF4;
    border-radius: 10px;
}

QWebEngineView#navWebMap {
    background-color: #FFFFFF;
    border: none;
    border-radius: 10px;
}

QListWidget#navStepsList {
    background-color: #FFFFFF;
    border: 1px solid #E3EAF4;
    border-radius: 10px;
    padding: 4px;
}

QListWidget#navStepsList::item {
    border: none;
    padding: 0;
}
