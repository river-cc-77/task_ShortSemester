  <property name="styleSheet">
   <string notr="true">/* 全局主窗口背景 */
QMainWindow{
    background-color:#f7f8fa;
}
/* 侧边栏容器：对象名 sideBarWidget，QWidget不识别padding，padding删掉，边距交给内部布局 */
QWidget#sideBarWidget
{
    background-color:#ffffff;
    border:1px solid #e2e2e2;
    border-radius:12px;
}
/* 侧边按钮普通状态 */
QPushButton
{
    background-color: #ffffff;
    border: 1px solid #dddddd;
    border-radius: 8px;
    padding:10px 4px;
    font-size:11pt;
    font-weight:400;
    text-align:center;
}
QPushButton:hover
{
    background-color: #f0f4ff;
    border-color:#b8c8f0;
}
/* 选中状态 */
QPushButton[selected=&quot;true&quot;]
{
    background-color:#4078e8;
    color:#ffffff;
    border:1px solid #4078e8;
}
/* 选中按钮按下时保持蓝色调，不要变灰色 */
QPushButton[selected=&quot;true&quot;]:pressed
{
    background-color:#2f62cc;
    color:#ffffff;
    border:1px solid #2f62cc;
}
/* 普通按钮按下 */
QPushButton:pressed
{
    background-color:#e9e9e9;
}
/* StackedWidget：外层大圆角白色卡片容器 */
QStackedWidget
{
    background-color:#ffffff;
    border-radius:12px;
    border:1px solid #e2e2e2;
}
/* 六个统计卡片【合并card1‑card6，统一背景边框】 */
QWidget#card1, QWidget#card2, QWidget#card3, QWidget#card4,
QWidget#card5, QWidget#card6
{
    background-color:#f0f7ff;
    border-radius:10px;
    border:1px solid #d9e8ff;
}

/* 卡片标题：15pt，修正为正确对象名 labTitleIncome */
QLabel#labTitleIncome,
QLabel#labTitleOrder,
QLabel#labTitleOnline,
QLabel#labTitleUser,
QLabel#labTitleMonthIncome,
QLabel#labTitleTotalIncome
{
    font-size: 15pt;
    color: #404040;
}
/* 卡片数值：23pt，新增本月、累计营收数值标签 */
QLabel#labIncome,
QLabel#labOrderCnt,
QLabel#labPileOnline,
QLabel#labUserCnt,
QLabel#labMonthIncome,
QLabel#labTotalIncome
{
    font-size: 23pt;
    font-weight: 600;
    color: #111111;
}

/* -------- 顶部两个操作按钮（刷新、图表按钮）可选微调 -------- */
QPushButton#btnRefresh, QPushButton#btnShowChart
{
    padding:6px 14px;
    font-size:10pt;
}
</string>
